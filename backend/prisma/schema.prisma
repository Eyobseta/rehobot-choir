// Rehobot Choir — Prisma schema
// Phase 1 (SRS v1.0) — V1.0 schema freeze
//
// Date policy:
//  - ALL user-facing dates are Ethiopian (E.C.) stored as y/m/d Int columns.
//  - For sort/filter/index only, a derived Gregorian @db.Date mirror is stored
//    in columns named *Gregorian. The E.C. columns are the source of truth.
//  - Date-only values are computed at UTC midnight (no TZ shifts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// USER
// ------------------------------------------------------------

enum UserRole {
  MEMBER
  LEADER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  email         String?    @unique
  passwordHash  String
  role          UserRole   @default(MEMBER)
  status        UserStatus @default(PENDING)

  mustChangePassword Boolean @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastActiveAt  DateTime?
  deletedAt     DateTime?

  sessions      Session[]
  accountLock   AccountLock?
  memberProfile MemberProfile?

  eventRsvps    EventRSVP[]
  notifications Notification[]
  createdEvents Event[]           @relation("CreatedEvents")
  createdAnnouncements Announcement[] @relation("CreatedAnnouncements")

  attendanceRecords      AttendanceRecord[] @relation("AttendanceRecords")
  attendanceRecordedBy   AttendanceRecord[] @relation("AttendanceRecordedBy")

  createdSongs       Song[]           @relation("CreatedSongs")
  songFavorites      SongFavorite[]
  zemaMemberships    ZemaMembership[] @relation("ZemaMember")
  zemaAssigned       ZemaMembership[] @relation("ZemaAssignedBy")
  songSubmissions    SongSubmission[] @relation("SongSubmissions")

  chatMemberships      ConversationMember[]
  chatMessages         ChatMessage[]
  chatReactions        MessageReaction[]
  chatPins             MessagePin[]
  chatReportsMade      MessageReport[]      @relation("ReportsMade")
  chatReportsResolved  MessageReport[]      @relation("ReportsResolved")
  chatReadStates       ChatReadState[]
  chatGroupsManaged    ChatGroup[]          @relation("GroupManager")
  chatGroupsCreated    ChatGroup[]          @relation("GroupCreatedBy")
    helpQueryLogs  HelpQueryLog[] @relation("HelpQueryLogUser")

  birthdayPosts         BirthdayPost[]         @relation("BirthdayPosts")
  birthdayComments      BirthdayComment[]      @relation("BirthdayComments")
  birthdayCommentLikes  BirthdayCommentLike[]  @relation("BirthdayCommentLikes")
  birthdayReactions     BirthdayReaction[]     @relation("BirthdayReactions")

  submittedMemories Memory[] @relation("SubmittedMemories")
  reviewedMemories  Memory[] @relation("ReviewedMemories")
  submittedQuotes   DailyQuote[] @relation("SubmittedQuotes")
  pushTokens        PushToken[]
  notificationPreference NotificationPreference?

  // Funding
  annualContributions      AnnualContributionRecord[]  @relation("AnnualParticipant")
  donationPayments         SpecialDonationPayment[]    @relation("DonationParticipant")
  fundingDeclarations      FundingDeclaration[]        @relation("DeclarationParticipant")
  fundingDecisions         FundingDeclaration[]        @relation("DeclarationDecidedBy")
  createdDonationCampaigns SpecialDonationCampaign[]   @relation("CampaignCreatedBy")
  fundingAuditActions      FundingAuditLog[]           @relation("FundingAuditActor")
  fundingConfigsCreated    AnnualFundingConfiguration[] @relation("FundingConfigCreatedBy")
  fundingConfigsUpdated    AnnualFundingConfiguration[] @relation("FundingConfigUpdatedBy")
  paymentInstructionsEdited PaymentInstructions[]      @relation("PaymentInstructionsUpdatedBy")

  @@index([status])
  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------
// SESSION
// ------------------------------------------------------------

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  lastUsedAt    DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// ------------------------------------------------------------
// ACCOUNT LOCK
// ------------------------------------------------------------

model AccountLock {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  updatedAt      DateTime @updatedAt

  @@map("account_locks")
}

// ------------------------------------------------------------
// REGISTRATION
// ------------------------------------------------------------

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationApplication {
  id            String            @id @default(cuid())

  fullName      String
  phone         String
  email         String
  passwordHash  String
  profilePhotoUrl String
  profilePhotoPublicId String
  gender        String

  // E.C. date of birth (source of truth) + Gregorian mirror for queries
  dateOfBirthEthYear   Int
  dateOfBirthEthMonth  Int
  dateOfBirthEthDay    Int
  dateOfBirthGregorian DateTime @db.Date

  emergencyContactName  String
  emergencyContactPhone String

  // Optional joining date (E.C.)
  joiningDateEthYear   Int?
  joiningDateEthMonth  Int?
  joiningDateEthDay    Int?
  joiningDateGregorian DateTime? @db.Date

  status        ApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedByUserId String?
  reviewedAt    DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([phone])
  @@index([status])
  @@map("registration_applications")
}

// ------------------------------------------------------------
// MEMBER PROFILE
// ------------------------------------------------------------

model MemberProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  gender             String

  // E.C. DOB + Gregorian mirror
  dateOfBirthEthYear   Int
  dateOfBirthEthMonth  Int
  dateOfBirthEthDay    Int
  dateOfBirthGregorian DateTime @db.Date

  emergencyContactName  String
  emergencyContactPhone String

  joiningDateEthYear   Int?
  joiningDateEthMonth  Int?
  joiningDateEthDay    Int?
  joiningDateGregorian DateTime? @db.Date

  profilePhotoUrl    String
  profilePhotoPublicId String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("member_profiles")
}

// ------------------------------------------------------------
// EVENTS
// ------------------------------------------------------------

enum EventStatus {
  DRAFT
  PUBLISHED
  DELETED
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?

  // E.C. event date + Gregorian mirror
  dateEthYear   Int
  dateEthMonth  Int
  dateEthDay    Int
  dateGregorian DateTime @db.Date

  coverImageUrl      String?
  coverImagePublicId String?

  status      EventStatus @default(DRAFT)

  createdByUserId String?
  createdBy       User?   @relation("CreatedEvents", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  attachments   EventAttachment[]
  announcements Announcement[]
  rsvps         EventRSVP[]

  @@index([status, dateGregorian])
  @@index([dateGregorian])
  @@map("events")
}

model EventAttachment {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  imageUrl        String
  imagePublicId   String

  createdAt       DateTime @default(now())

  @@index([eventId])
  @@map("event_attachments")
}

enum RsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

model EventRSVP {
  id         String       @id @default(cuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  response   RsvpResponse
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// ------------------------------------------------------------
// ATTENDANCE
// ------------------------------------------------------------

enum GatheringType {
  TUESDAY_ZEMA
  THURSDAY_CHOIR
  SATURDAY_CHOIR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceRecord {
  id          String            @id @default(cuid())

  memberId    String
  member      User              @relation("AttendanceRecords", fields: [memberId], references: [id], onDelete: Cascade)

  gathering   GatheringType

  // E.C. date + Gregorian mirror
  dateEthYear   Int
  dateEthMonth  Int
  dateEthDay    Int
  dateGregorian DateTime @db.Date

  status      AttendanceStatus
  lockedAt    DateTime?

  recordedByUserId String?
  recordedBy       User?        @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([memberId, gathering, dateGregorian])
  @@index([gathering, dateGregorian])
  @@index([memberId])
  @@map("attendance_records")
}

// ------------------------------------------------------------
// ANNOUNCEMENTS
// ------------------------------------------------------------

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  DELETED
}

model Announcement {
  id          String              @id @default(cuid())
  title       String
  message     String

  publishAt   DateTime            @default(now())
  status      AnnouncementStatus  @default(DRAFT)

  imageUrl        String?
  imagePublicId   String?

  eventId     String?
  event       Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdBy       User?           @relation("CreatedAnnouncements", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  songs       AnnouncementSong[]

  @@index([status, publishAt])
  @@index([publishAt])
  @@map("announcements")
}

model AnnouncementSong {
  id             String        @id @default(cuid())
  announcementId String
  announcement   Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  songId         String
  songTitle      String

  createdAt      DateTime      @default(now())

  @@index([announcementId])
  @@map("announcement_songs")
}

// ------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------

enum NotificationType {
  ANNOUNCEMENT
  EVENT_REMINDER
  CHAT_MESSAGE
  BIRTHDAY
  SONG_PUBLISHED
  MEMORY_PUBLISHED
  LEADERSHIP_CHANGE
  DAILY_QUOTE
  FUNDING_REMINDER
  FUNDING_VERIFICATION_NEEDED
  FUNDING_RESULT
  FUNDING_CAMPAIGN
}

model Notification {
  id          String            @id @default(cuid())
  recipientId String
  recipient   User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String?

  relatedEntityType String?
  relatedEntityId   String?

  createdAt   DateTime          @default(now())
  readAt      DateTime?
  expiresAt   DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// SONGS / ZEMA
// ------------------------------------------------------------

model SongCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs     Song[]

  @@map("song_categories")
}

enum SongStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RETURNED
  UNPUBLISHED
  DELETED
}

model Song {
  id            String      @id @default(cuid())

  title         String
  lyrics        String?
  audioUrl      String?
  audioPublicId String?
  youtubeUrl    String?

  categoryId    String?
  category      SongCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status        SongStatus  @default(DRAFT)

  dateAdded     DateTime    @default(now())
  publishedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  createdByUserId String?
  createdBy       User?     @relation("CreatedSongs", fields: [createdByUserId], references: [id], onDelete: SetNull)

  favorites     SongFavorite[]
  submissions   SongSubmission[]

  @@index([status, dateAdded])
  @@index([categoryId])
  @@map("songs")
}

model SongFavorite {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([userId])
  @@map("song_favorites")
}

model ZemaMembership {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation("ZemaMember", fields: [userId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedBy       User?   @relation("ZemaAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  assignedAt  DateTime @default(now())
  removedAt   DateTime?

  @@index([userId])
  @@index([userId, removedAt])
  @@map("zema_memberships")
}

enum SubmissionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  RETURNED
}

model SongSubmission {
  id         String            @id @default(cuid())

  songId     String
  song       Song              @relation(fields: [songId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User      @relation("SongSubmissions", fields: [submittedByUserId], references: [id], onDelete: Cascade)

  status     SubmissionStatus  @default(DRAFT)
  returnReason String?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewedAt DateTime?

  @@index([status])
  @@index([submittedByUserId])
  @@map("song_submissions")
}

// ------------------------------------------------------------
// MEMORIES
// ------------------------------------------------------------

enum MemoryStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DELETED
}

enum MemoryMediaType {
  PHOTO
  AUDIO
  YOUTUBE
}

model Memory {
  id          String        @id @default(cuid())

  title       String
  description String?

  // E.C. memory date + Gregorian mirror
  dateEthYear   Int
  dateEthMonth  Int
  dateEthDay    Int
  dateGregorian DateTime @db.Date

  status      MemoryStatus  @default(PENDING_REVIEW)
  rejectionReason String?
  publishedAt DateTime?

  submittedByUserId String?
  submittedBy       User?   @relation("SubmittedMemories", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  reviewedByUserId  String?
  reviewedBy        User?   @relation("ReviewedMemories", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  media       MemoryMedia[]

  @@index([status, dateGregorian])
  @@index([dateGregorian])
  @@index([status, publishedAt])
  @@map("memories")
}

model MemoryMedia {
  id        String          @id @default(cuid())

  memoryId  String
  memory    Memory          @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  type      MemoryMediaType

  storageUrl      String?
  storagePublicId String?
  youtubeUrl      String?

  createdAt DateTime        @default(now())

  @@index([memoryId])
  @@map("memory_media")
}

// ------------------------------------------------------------
// DAILY BIBLE QUOTE
// ------------------------------------------------------------

enum DailyQuoteStatus {
  PUBLISHED
  DELETED
}

model DailyQuote {
  id                String            @id @default(cuid())

  // E.C. day + Gregorian mirror for unique lookup
  dateEthYear       Int
  dateEthMonth      Int
  dateEthDay        Int
  dateGregorian     DateTime          @db.Date

  quoteText         String
  source            String

  youtubeUrl        String?
  audioUrl          String?
  audioPublicId     String?

  status            DailyQuoteStatus  @default(PUBLISHED)

  submittedByUserId String?
  submittedBy       User?             @relation("SubmittedQuotes", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([dateGregorian])
  @@index([dateGregorian])
  @@map("daily_quotes")
}

// ------------------------------------------------------------
// PUSH TOKENS
// ------------------------------------------------------------

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String   @unique
  platform   String
  deviceLabel String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ------------------------------------------------------------
// NOTIFICATION PREFERENCES
// ------------------------------------------------------------

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announcementsEnabled     Boolean  @default(true)
  eventRemindersEnabled    Boolean  @default(true)
  chatMessagesEnabled      Boolean  @default(true)
  birthdaysEnabled         Boolean  @default(true)
  newSongEnabled           Boolean  @default(true)
  newMemoryEnabled         Boolean  @default(true)
  dailyQuoteEnabled        Boolean  @default(true)
  fundingReminderEnabled   Boolean  @default(true)   // NEW
  fundingCampaignEnabled   Boolean  @default(true)   // NEW

  updatedAt                DateTime @updatedAt

  @@map("notification_preferences")
}

// ------------------------------------------------------------
// BIRTHDAY POSTS
// ------------------------------------------------------------

model BirthdayPost {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation("BirthdayPosts", fields: [userId], references: [id], onDelete: Cascade)

  year        Int

  // E.C. birthday date + mirror
  birthdayEthYear   Int
  birthdayEthMonth  Int
  birthdayEthDay    Int
  birthdayGregorian DateTime @db.Date

  createdAt   DateTime @default(now())

  comments    BirthdayComment[]
  reactions   BirthdayReaction[]

  @@unique([userId, year])
  @@index([birthdayGregorian])
  @@map("birthday_posts")
}

model BirthdayComment {
  id              String   @id @default(cuid())

  postId          String
  post            BirthdayPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId        String
  author          User     @relation("BirthdayComments", fields: [authorId], references: [id], onDelete: Cascade)

  parentCommentId String?
  parentComment   BirthdayComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         BirthdayComment[] @relation("CommentReplies")

  text            String
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  likes           BirthdayCommentLike[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("birthday_comments")
}

model BirthdayCommentLike {
  id         String   @id @default(cuid())

  commentId  String
  comment    BirthdayComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("BirthdayCommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("birthday_comment_likes")
}

model BirthdayReaction {
  id         String   @id @default(cuid())

  postId     String
  post       BirthdayPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("BirthdayReactions", fields: [userId], references: [id], onDelete: Cascade)

  emoji      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId])
  @@map("birthday_reactions")
}

// ------------------------------------------------------------
// CHAT
// ------------------------------------------------------------

enum ConversationType {
  DIRECT
  GENERAL
  GROUP
}

enum ChatMessageType {
  TEXT
  PHOTO
  VOICE
}

enum ChatMediaType {
  PHOTO
  VOICE
}

enum MessageReportResolution {
  KEPT
  DELETED
  DISMISSED
}

model ChatConversation {
  id             String           @id @default(cuid())
  type           ConversationType

  directKey      String?          @unique

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lastMessageAt  DateTime?

  members        ConversationMember[]
  messages       ChatMessage[]
  pins           MessagePin[]
  readStates     ChatReadState[]
  group          ChatGroup?

  @@index([type, lastMessageAt])
  @@map("chat_conversations")
}

model ConversationMember {
  id             String            @id @default(cuid())

  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime          @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model ChatGroup {
  id              String            @id @default(cuid())

  conversationId  String            @unique
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  name            String            @unique

  photoUrl        String?
  photoPublicId   String?

  managerId       String
  manager         User              @relation("GroupManager", fields: [managerId], references: [id], onDelete: Restrict)

  createdByUserId String?
  createdBy       User?             @relation("GroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("chat_groups")
}

model ChatMessage {
  id             String            @id @default(cuid())

  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  type           ChatMessageType   @default(TEXT)

  text           String?
  clientId       String?

  replyToId      String?
  replyTo        ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]     @relation("MessageReplies")

  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  media          ChatMedia[]
  reactions      MessageReaction[]
  pins           MessagePin[]
  reports        MessageReport[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, editedAt])
  @@index([conversationId, deletedAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatMedia {
  id              String          @id @default(cuid())

  messageId       String
  message         ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type            ChatMediaType

  storageUrl      String
  storagePublicId String

  durationSeconds Int?
  retentionUntil  DateTime

  createdAt       DateTime        @default(now())

  @@index([messageId])
  @@index([retentionUntil])
  @@map("chat_media")
}

model MessageReaction {
  id         String       @id @default(cuid())

  messageId  String
  message    ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji      String
  createdAt  DateTime     @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([createdAt])
  @@map("message_reactions")
}

model MessagePin {
  id              String            @id @default(cuid())

  conversationId  String
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId       String
  message         ChatMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedByUserId  String
  pinnedBy        User              @relation(fields: [pinnedByUserId], references: [id], onDelete: Cascade)

  pinnedAt        DateTime          @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("message_pins")
}

model MessageReport {
  id                String                    @id @default(cuid())

  messageId         String
  message           ChatMessage               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporterId        String
  reporter          User                      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt         DateTime                  @default(now())

  resolution        MessageReportResolution?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolvedBy        User?                     @relation("ReportsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  retainUntil       DateTime

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@index([reporterId])
  @@index([resolvedAt])
  @@map("message_reports")
}

model ChatReadState {
  id                 String            @id @default(cuid())

  conversationId     String
  conversation       ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt         DateTime          @default(now())
  lastReadMessageId  String?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@map("chat_read_states")
}

// ============================================================
// FUNDING — SRS v2.0 (V1.0 schema freeze)
//
// Storage policy:
//  - Money: Int santim (1 ETB = 100 santim). NEVER Float/Decimal.
//  - Dates: E.C. y/m/d Ints = source of truth for display.
//           *Gregorian @db.Date = derived index for sort/filter only.
//  - Declarations are append-only. Resubmission after rejection = new row.
// ============================================================

enum FundingStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
}

enum DeclarationStatus {
  PENDING
  APPROVED
  REJECTED
  VOID
}

enum FundingRecordType {
  ANNUAL
  DONATION
  CAMPAIGN
  CONFIGURATION
  PAYMENT_INSTRUCTIONS
}

enum DonationType {
  VOLUNTARY
  REQUIRED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  BANK
  TELEBIRR
}

model AnnualFundingConfiguration {
  id                    String   @id @default(cuid())

  contributionYear      Int      @unique        // E.C. year
  amountMinor           Int                      // santim

  includeMembers        Boolean  @default(true)
  includeLeaders        Boolean  @default(true)

  // E.C. expiry (source of truth) + mirror
  expiryEthYear         Int
  expiryEthMonth        Int
  expiryEthDay          Int
  expiryGregorian       DateTime @db.Date

  // E.C. deadline (source of truth) + mirror
  deadlineEthYear       Int
  deadlineEthMonth      Int
  deadlineEthDay        Int
  deadlineGregorian     DateTime @db.Date

  monthlyReminderEnabled Boolean @default(true)
  monthlyReminderEthDay  Int     @default(1)
  preDeadlineReminderDays Int    @default(7)

  receiptUploadsEnabled Boolean  @default(false)
  referenceEnabled      Boolean  @default(true)

  active                Boolean  @default(true)

  createdByUserId       String?
  createdBy             User?    @relation("FundingConfigCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId       String?
  updatedBy             User?    @relation("FundingConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  records               AnnualContributionRecord[]

  @@map("annual_funding_configurations")
}

model AnnualContributionRecord {
  id               String        @id @default(cuid())

  configId         String
  config           AnnualFundingConfiguration @relation(fields: [configId], references: [id], onDelete: Restrict)

  participantId    String
  participant      User          @relation("AnnualParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  contributionYear Int
  amountDueMinor   Int           // snapshot at creation
  status           FundingStatus @default(UNPAID)
  paidMinor        Int           @default(0)

  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?

  version          Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  declarations     FundingDeclaration[]

  @@unique([participantId, contributionYear])
  @@index([contributionYear, status])
  @@index([configId])
  @@map("annual_contribution_records")
}

model SpecialDonationCampaign {
  id                   String         @id @default(cuid())

  title                String
  description          String
  donationType         DonationType

  requestedAmountMinor Int?
  targetAmountMinor    Int?

  // Optional start (E.C. + mirror)
  startEthYear         Int?
  startEthMonth        Int?
  startEthDay          Int?
  startGregorian       DateTime?      @db.Date

  // Required deadline (E.C. + mirror)
  deadlineEthYear      Int
  deadlineEthMonth     Int
  deadlineEthDay       Int
  deadlineGregorian    DateTime       @db.Date

  imageUrl             String?
  imagePublicId        String?

  status               CampaignStatus @default(DRAFT)

  // NEW: per-campaign receipt toggle (falls back to global config when null)
  receiptUploadsEnabled Boolean?
  referenceEnabled      Boolean?

  createdByUserId      String?
  createdBy            User?          @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  publishedAt          DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?

  payments             SpecialDonationPayment[]

  @@index([status, deadlineGregorian])
  @@map("special_donation_campaigns")
}

model SpecialDonationPayment {
  id               String        @id @default(cuid())

  campaignId       String
  campaign         SpecialDonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  participantId    String
  participant      User          @relation("DonationParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  amountMinor      Int
  status           FundingStatus @default(UNPAID)
  paidMinor        Int           @default(0)

  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?
  version          Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  declarations     FundingDeclaration[]

  @@unique([campaignId, participantId])
  @@index([campaignId, status])
  @@map("special_donation_payments")
}

model FundingDeclaration {
  id                String            @id @default(cuid())

  annualRecordId    String?
  annualRecord      AnnualContributionRecord? @relation(fields: [annualRecordId], references: [id], onDelete: Cascade)
  donationPaymentId String?
  donationPayment   SpecialDonationPayment?   @relation(fields: [donationPaymentId], references: [id], onDelete: Cascade)

  participantId     String
  participant       User              @relation("DeclarationParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  amountMinor       Int

  // v2.0 SRS: Payment method is REQUIRED on every declaration.
  paymentMethod     PaymentMethod

  reference         String?
  receiptUrl        String?
  receiptPublicId   String?

  clientId          String?

  status            DeclarationStatus @default(PENDING)
  declaredAt        DateTime          @default(now())

  decidedByUserId   String?
  decidedBy         User?             @relation("DeclarationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  rejectionReason   String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([participantId, clientId])
  @@index([annualRecordId, declaredAt])
  @@index([donationPaymentId, declaredAt])
  @@index([status, declaredAt])
  @@map("funding_declarations")
}

model FundingAuditLog {
  id                String            @id @default(cuid())

  actorId           String?
  actor             User?             @relation("FundingAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action            String
  recordType        FundingRecordType
  recordId          String

  previousStatus    String?
  newStatus         String?
  reason            String?
  details           Json?

  createdAt         DateTime          @default(now())

  @@index([recordType, recordId])
  @@index([actorId])
  @@index([createdAt])
  @@map("funding_audit_logs")
}

model PaymentInstructions {
  id                String        @id @default(cuid())

  method            PaymentMethod
  providerName      String
  accountHolderName String
  accountIdentifier String
  note              String?
  active            Boolean       @default(true)

  updatedByUserId   String?
  updatedBy         User?         @relation("PaymentInstructionsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // One row per (method, provider, identifier). Add/modify = new row or update in place.
  @@unique([method, providerName, accountIdentifier])
  @@index([active])
  @@map("payment_instructions")
}

model FundingReminderLog {
  id         String   @id @default(cuid())
  recipientId String
  recordType FundingRecordType
  recordId   String
  kind       String
  periodKey  String
  sentAt     DateTime @default(now())

  @@unique([recipientId, recordType, recordId, kind, periodKey])
  @@map("funding_reminder_logs")
}

// ============================================================
// HELP / IN-APP ASSISTANT
// ============================================================

enum HelpFeedback {
  NONE
  UP
  DOWN
}

model HelpEntry {
  id                 String         @id @default(cuid())
  slug               String         @unique
  category           String

  intentsEn          String[]
  intentsAm          String[]
  questionVariantsEn String[]
  questionVariantsAm String[]
  answerEn           String
  answerAm           String         @default("")

  // Semantic key: HOME | SONGS | MEMORIES | CHAT | PROFILE | FUNDING
  deepLink           String?

  // Who can see this entry. Uses the existing UserRole enum.
  visibleToRoles     UserRole[]

  // React Navigation route names to boost, e.g. ["Profile", "Funding"]
  screenHints        String[]

  active             Boolean        @default(true)
  sortOrder          Int            @default(0)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  queryLogs          HelpQueryLog[] @relation("HelpMatchedEntry")

  @@index([category])
  @@index([active])
  @@map("help_entries")
}

model HelpQueryLog {
  id             String        @id @default(cuid())

  userId         String?
  user           User?         @relation("HelpQueryLogUser", fields: [userId], references: [id], onDelete: SetNull)

  roleAtQuery    UserRole?
  screen         String?
  language       String
  rawQuery       String?       // PII-redacted by the service before insert
  matchedEntryId String?
  matchedEntry   HelpEntry?    @relation("HelpMatchedEntry", fields: [matchedEntryId], references: [id], onDelete: SetNull)
  matchScore     Float?

  feedback       HelpFeedback  @default(NONE)
  feedbackNote   String?

  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([matchedEntryId])
  @@index([userId])
  @@map("help_query_logs")
}