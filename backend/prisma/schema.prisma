// Rehobot Choir — Prisma schema
// Phase 1 (SRS v1.0)
//
// Chat changes vs previous version:
//  - datasource: directUrl (Neon pooled URL cannot run migrations)
//  - ChatGroup.createdByUserId is optional (SetNull on a required field was invalid)
//  - ChatMessage.clientId + @@unique([senderId, clientId])  (idempotent sends)
//  - MessageReport @@unique([messageId, reporterId])        (one report per user)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// USER
// ------------------------------------------------------------

enum UserRole {
  MEMBER
  LEADER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  email         String?    @unique
  passwordHash  String
  role          UserRole   @default(MEMBER)
  status        UserStatus @default(PENDING)

  mustChangePassword Boolean @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastActiveAt  DateTime?
  deletedAt     DateTime?

  sessions      Session[]
  accountLock   AccountLock?
  memberProfile MemberProfile?

  eventRsvps    EventRSVP[]
  notifications Notification[]
  createdEvents Event[]           @relation("CreatedEvents")
  createdAnnouncements Announcement[] @relation("CreatedAnnouncements")

  attendanceRecords      AttendanceRecord[] @relation("AttendanceRecords")
  attendanceRecordedBy   AttendanceRecord[] @relation("AttendanceRecordedBy")

  createdSongs       Song[]           @relation("CreatedSongs")
  songFavorites      SongFavorite[]
  zemaMemberships    ZemaMembership[] @relation("ZemaMember")
  zemaAssigned       ZemaMembership[] @relation("ZemaAssignedBy")
  songSubmissions    SongSubmission[] @relation("SongSubmissions")

  chatMemberships      ConversationMember[]
  chatMessages         ChatMessage[]
  chatReactions        MessageReaction[]
  chatPins             MessagePin[]
  chatReportsMade      MessageReport[]      @relation("ReportsMade")
  chatReportsResolved  MessageReport[]      @relation("ReportsResolved")
  chatReadStates       ChatReadState[]
  chatGroupsManaged    ChatGroup[]          @relation("GroupManager")
  chatGroupsCreated    ChatGroup[]          @relation("GroupCreatedBy")

  birthdayPosts         BirthdayPost[]         @relation("BirthdayPosts")
  birthdayComments      BirthdayComment[]      @relation("BirthdayComments")
  birthdayCommentLikes  BirthdayCommentLike[]  @relation("BirthdayCommentLikes")
  birthdayReactions     BirthdayReaction[]     @relation("BirthdayReactions")

  submittedMemories Memory[] @relation("SubmittedMemories")
  reviewedMemories  Memory[] @relation("ReviewedMemories")
  submittedQuotes   DailyQuote[] @relation("SubmittedQuotes")
  pushTokens        PushToken[]
  notificationPreference NotificationPreference?

  // Funding (annual hosting contribution + special donations)
  annualContributions      AnnualContributionRecord[]  @relation("AnnualParticipant")
  donationPayments         SpecialDonationPayment[]    @relation("DonationParticipant")
  fundingDeclarations      FundingDeclaration[]        @relation("DeclarationParticipant")
  fundingDecisions         FundingDeclaration[]        @relation("DeclarationDecidedBy")
  createdDonationCampaigns SpecialDonationCampaign[]   @relation("CampaignCreatedBy")
  fundingAuditActions      FundingAuditLog[]           @relation("FundingAuditActor")
  fundingConfigsCreated    AnnualFundingConfiguration[] @relation("FundingConfigCreatedBy")
  fundingConfigsUpdated    AnnualFundingConfiguration[] @relation("FundingConfigUpdatedBy")
  paymentInstructionsEdited PaymentInstructions[]      @relation("PaymentInstructionsUpdatedBy")

  @@index([status])
  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------
// SESSION
// ------------------------------------------------------------

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  lastUsedAt    DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// ------------------------------------------------------------
// ACCOUNT LOCK
// ------------------------------------------------------------

model AccountLock {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  updatedAt      DateTime @updatedAt

  @@map("account_locks")
}

// ------------------------------------------------------------
// REGISTRATION
// ------------------------------------------------------------

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationApplication {
  id            String            @id @default(cuid())

  fullName      String
  phone         String
  email         String
  passwordHash  String
  profilePhotoUrl String
  profilePhotoPublicId String
  gender        String
  dateOfBirth   DateTime
  emergencyContactName  String
  emergencyContactPhone String
  joiningDate   DateTime?

  status        ApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedByUserId String?
  reviewedAt    DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([phone])
  @@index([status])
  @@map("registration_applications")
}

// ------------------------------------------------------------
// MEMBER PROFILE
// ------------------------------------------------------------

model MemberProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  gender             String
  dateOfBirth        DateTime
  emergencyContactName  String
  emergencyContactPhone String
  joiningDate        DateTime?
  profilePhotoUrl    String
  profilePhotoPublicId String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("member_profiles")
}

// ------------------------------------------------------------
// EVENTS
// ------------------------------------------------------------

enum EventStatus {
  DRAFT
  PUBLISHED
  DELETED
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?
  date        DateTime

  coverImageUrl      String?
  coverImagePublicId String?

  status      EventStatus @default(DRAFT)

  createdByUserId String?
  createdBy       User?   @relation("CreatedEvents", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  attachments   EventAttachment[]
  announcements Announcement[]
  rsvps         EventRSVP[]

  @@index([status, date])
  @@index([date])
  @@map("events")
}

model EventAttachment {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  imageUrl        String
  imagePublicId   String

  createdAt       DateTime @default(now())

  @@index([eventId])
  @@map("event_attachments")
}

enum RsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

model EventRSVP {
  id         String       @id @default(cuid())
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  response   RsvpResponse
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// ------------------------------------------------------------
// ATTENDANCE
// ------------------------------------------------------------

enum GatheringType {
  TUESDAY_ZEMA
  THURSDAY_CHOIR
  SATURDAY_CHOIR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceRecord {
  id          String            @id @default(cuid())

  memberId    String
  member      User              @relation("AttendanceRecords", fields: [memberId], references: [id], onDelete: Cascade)

  gathering   GatheringType
  date        DateTime
  status      AttendanceStatus
  lockedAt    DateTime?

  recordedByUserId String?
  recordedBy       User?        @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([memberId, gathering, date])
  @@index([gathering, date])
  @@index([memberId])
  @@map("attendance_records")
}

// ------------------------------------------------------------
// ANNOUNCEMENTS
// ------------------------------------------------------------

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  DELETED
}

model Announcement {
  id          String              @id @default(cuid())
  title       String
  message     String

  publishAt   DateTime            @default(now())
  status      AnnouncementStatus  @default(DRAFT)

  imageUrl        String?
  imagePublicId   String?

  eventId     String?
  event       Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdBy       User?           @relation("CreatedAnnouncements", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  songs       AnnouncementSong[]

  @@index([status, publishAt])
  @@index([publishAt])
  @@map("announcements")
}

model AnnouncementSong {
  id             String        @id @default(cuid())
  announcementId String
  announcement   Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  songId         String
  songTitle      String

  createdAt      DateTime      @default(now())

  @@index([announcementId])
  @@map("announcement_songs")
}

// ------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------

enum NotificationType {
  ANNOUNCEMENT
  EVENT_REMINDER
  CHAT_MESSAGE
  BIRTHDAY
  SONG_PUBLISHED
  MEMORY_PUBLISHED
  LEADERSHIP_CHANGE
  DAILY_QUOTE
  FUNDING_REMINDER
  FUNDING_VERIFICATION_NEEDED
  FUNDING_RESULT
  FUNDING_CAMPAIGN
}

model Notification {
  id          String            @id @default(cuid())
  recipientId String
  recipient   User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String?

  relatedEntityType String?
  relatedEntityId   String?

  createdAt   DateTime          @default(now())
  readAt      DateTime?
  expiresAt   DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// SONGS / ZEMA
// ------------------------------------------------------------

model SongCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs     Song[]

  @@map("song_categories")
}

enum SongStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RETURNED
  UNPUBLISHED
  DELETED
}

model Song {
  id            String      @id @default(cuid())

  title         String
  lyrics        String?
  audioUrl      String?
  audioPublicId String?
  youtubeUrl    String?

  categoryId    String?
  category      SongCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status        SongStatus  @default(DRAFT)

  dateAdded     DateTime    @default(now())
  publishedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  createdByUserId String?
  createdBy       User?     @relation("CreatedSongs", fields: [createdByUserId], references: [id], onDelete: SetNull)

  favorites     SongFavorite[]
  submissions   SongSubmission[]

  @@index([status, dateAdded])
  @@index([categoryId])
  @@map("songs")
}

model SongFavorite {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([userId])
  @@map("song_favorites")
}

model ZemaMembership {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation("ZemaMember", fields: [userId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedBy       User?   @relation("ZemaAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  assignedAt  DateTime @default(now())
  removedAt   DateTime?

  @@index([userId])
  @@index([userId, removedAt])
  @@map("zema_memberships")
}

enum SubmissionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  RETURNED
}

model SongSubmission {
  id         String            @id @default(cuid())

  songId     String
  song       Song              @relation(fields: [songId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User      @relation("SongSubmissions", fields: [submittedByUserId], references: [id], onDelete: Cascade)

  status     SubmissionStatus  @default(DRAFT)
  returnReason String?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewedAt DateTime?

  @@index([status])
  @@index([submittedByUserId])
  @@map("song_submissions")
}

// ------------------------------------------------------------
// MEMORIES (SRS 14)
// ------------------------------------------------------------

enum MemoryStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DELETED
}

enum MemoryMediaType {
  PHOTO
  AUDIO
  YOUTUBE
}

model Memory {
  id          String        @id @default(cuid())

  title       String
  description String?
  date        DateTime

  status      MemoryStatus  @default(PENDING_REVIEW)
  rejectionReason String?
  publishedAt DateTime?

  submittedByUserId String?
  submittedBy       User?   @relation("SubmittedMemories", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  reviewedByUserId  String?
  reviewedBy        User?   @relation("ReviewedMemories", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  media       MemoryMedia[]

  @@index([status, date])
  @@index([date])
  @@index([status, publishedAt])
  @@map("memories")
}

model MemoryMedia {
  id        String          @id @default(cuid())

  memoryId  String
  memory    Memory          @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  type      MemoryMediaType

  // For PHOTO / AUDIO
  storageUrl      String?
  storagePublicId String?

  // For YOUTUBE
  youtubeUrl      String?

  createdAt DateTime        @default(now())

  @@index([memoryId])
  @@map("memory_media")
}

// ------------------------------------------------------------
// DAILY BIBLE QUOTE (feature added beyond base SRS)
// One quote per calendar day, enforced by a unique index.
// ------------------------------------------------------------

enum DailyQuoteStatus {
  PUBLISHED
  DELETED
}

model DailyQuote {
  id                String            @id @default(cuid())

  // Calendar day the quote belongs to. Stored as a real date (no time).
  dateOnly          DateTime          @db.Date

  quoteText         String
  source            String            // e.g. "Psalm 4:4", "John 3:16"

  youtubeUrl        String?
  audioUrl          String?
  audioPublicId     String?

  status            DailyQuoteStatus  @default(PUBLISHED)

  submittedByUserId String?
  submittedBy       User?             @relation("SubmittedQuotes", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([dateOnly])
  @@index([dateOnly])
  @@map("daily_quotes")
}

// ------------------------------------------------------------
// PUSH TOKENS (SRS 32)
// One row per device that has opted in to notifications.
// ------------------------------------------------------------

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String   @unique     // Expo push token
  platform   String                // "android" | "ios" | "web"
  deviceLabel String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ------------------------------------------------------------
// NOTIFICATION PREFERENCES (SRS 16.4)
// ------------------------------------------------------------

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announcementsEnabled     Boolean  @default(true)
  eventRemindersEnabled    Boolean  @default(true)
  chatMessagesEnabled      Boolean  @default(true)   // forced on per SRS 16.4
  birthdaysEnabled         Boolean  @default(true)
  newSongEnabled           Boolean  @default(true)
  newMemoryEnabled         Boolean  @default(true)
  dailyQuoteEnabled        Boolean  @default(true)

  updatedAt                DateTime @updatedAt

  @@map("notification_preferences")
}

// ------------------------------------------------------------
// BIRTHDAY POSTS, COMMENTS, LIKES, REACTIONS
// ------------------------------------------------------------

model BirthdayPost {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation("BirthdayPosts", fields: [userId], references: [id], onDelete: Cascade)

  year        Int
  birthdayDate DateTime  // Full date this post celebrates (UTC midnight)

  createdAt   DateTime @default(now())

  comments    BirthdayComment[]
  reactions   BirthdayReaction[]

  @@unique([userId, year])
  @@index([year])
  @@map("birthday_posts")
}

model BirthdayComment {
  id              String   @id @default(cuid())

  postId          String
  post            BirthdayPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId        String
  author          User     @relation("BirthdayComments", fields: [authorId], references: [id], onDelete: Cascade)

  // null = top-level comment, otherwise a reply.
  parentCommentId String?
  parentComment   BirthdayComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         BirthdayComment[] @relation("CommentReplies")

  text            String
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  likes           BirthdayCommentLike[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("birthday_comments")
}

model BirthdayCommentLike {
  id         String   @id @default(cuid())

  commentId  String
  comment    BirthdayComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("BirthdayCommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("birthday_comment_likes")
}

model BirthdayReaction {
  id         String   @id @default(cuid())

  postId     String
  post       BirthdayPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("BirthdayReactions", fields: [userId], references: [id], onDelete: Cascade)

  // One emoji per user per post. Can be changed.
  emoji      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId])
  @@map("birthday_reactions")
}

// ------------------------------------------------------------
// CHAT (SRS 19)
// ------------------------------------------------------------

enum ConversationType {
  DIRECT
  GENERAL
  GROUP
}

enum ChatMessageType {
  TEXT
  PHOTO
  VOICE
}

enum ChatMediaType {
  PHOTO
  VOICE
}

enum MessageReportResolution {
  KEPT
  DELETED
  DISMISSED
}

model ChatConversation {
  id             String           @id @default(cuid())
  type           ConversationType

  // DIRECT: sorted "userId1|userId2" so a DM is never duplicated.
  // GENERAL: the literal "GENERAL" so only one General chat can exist.
  directKey      String?          @unique

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lastMessageAt  DateTime?

  members        ConversationMember[]
  messages       ChatMessage[]
  pins           MessagePin[]
  readStates     ChatReadState[]
  group          ChatGroup?

  @@index([type, lastMessageAt])
  @@map("chat_conversations")
}

model ConversationMember {
  id             String            @id @default(cuid())

  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime          @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model ChatGroup {
  id              String            @id @default(cuid())

  conversationId  String            @unique
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // SRS 19.5 — active group names must be unique.
  name            String            @unique

  photoUrl        String?
  photoPublicId   String?

  managerId       String
  manager         User              @relation("GroupManager", fields: [managerId], references: [id], onDelete: Restrict)

  // Optional so that onDelete: SetNull is valid.
  createdByUserId String?
  createdBy       User?             @relation("GroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("chat_groups")
}

model ChatMessage {
  id             String            @id @default(cuid())

  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  type           ChatMessageType   @default(TEXT)

  // For TEXT messages. For PHOTO/VOICE, this is an optional caption.
  text           String?

  // Client-generated id so a retried send never creates a duplicate.
  clientId       String?

  // For replies (SRS 19.19)
  replyToId      String?
  replyTo        ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]     @relation("MessageReplies")

  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  media          ChatMedia[]
  reactions      MessageReaction[]
  pins           MessagePin[]
  reports        MessageReport[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, editedAt])
  @@index([conversationId, deletedAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatMedia {
  id              String          @id @default(cuid())

  messageId       String
  message         ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type            ChatMediaType

  storageUrl      String
  storagePublicId String

  // SRS 19.11 — voice messages record the original duration (max 60).
  durationSeconds Int?

  // SRS 19.15 — 1 year retention for chat media.
  retentionUntil  DateTime

  createdAt       DateTime        @default(now())

  @@index([messageId])
  @@index([retentionUntil])
  @@map("chat_media")
}

model MessageReaction {
  id         String       @id @default(cuid())

  messageId  String
  message    ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji      String
  createdAt  DateTime     @default(now())

  // SRS 19.20 — a member may add multiple distinct emojis to one message.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([createdAt])
  @@map("message_reactions")
}

model MessagePin {
  id              String            @id @default(cuid())

  conversationId  String
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId       String
  message         ChatMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedByUserId  String
  pinnedBy        User              @relation(fields: [pinnedByUserId], references: [id], onDelete: Cascade)

  pinnedAt        DateTime          @default(now())

  // SRS 19.24 — one pin per message.
  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("message_pins")
}

model MessageReport {
  id                String                    @id @default(cuid())

  messageId         String
  message           ChatMessage               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporterId        String
  reporter          User                      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt         DateTime                  @default(now())

  resolution        MessageReportResolution?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolvedBy        User?                     @relation("ReportsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // SRS 19.23 — records retained for 30 days after creation.
  retainUntil       DateTime

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@index([reporterId])
  @@index([resolvedAt])
  @@map("message_reports")
}

model ChatReadState {
  id                 String            @id @default(cuid())

  conversationId     String
  conversation       ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt         DateTime          @default(now())
  lastReadMessageId  String?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@map("chat_read_states")
}

// ============================================================
// FUNDING (Funding Features SRS v1.0)
//  - All money is stored as integer santim (1 ETB = 100 santim). Never Float/Decimal-from-JS.
//  - Date-only values are stored twice: Ethiopian y/m/d (what users entered/see)
//    and a normalised Gregorian @db.Date (what queries/sorting use).
//  - Declarations are append-only history. Resubmission after rejection creates a
//    NEW FundingDeclaration; the rejected one is never overwritten.
// ============================================================

enum FundingStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
}

enum DeclarationStatus {
  PENDING
  APPROVED
  REJECTED
  VOID          // e.g. campaign cancelled while pending; kept for history
}

enum FundingRecordType {
  ANNUAL
  DONATION
  CAMPAIGN
  CONFIGURATION
  PAYMENT_INSTRUCTIONS
}

enum DonationType {
  VOLUNTARY
  REQUIRED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  BANK
  TELEBIRR
}

// One row per contribution year (Ethiopian year).
model AnnualFundingConfiguration {
  id                    String   @id @default(cuid())

  contributionYear      Int      @unique        // Ethiopian year, e.g. 2019
  amountMinor           Int                      // santim; default 10000 = 100 ETB

  includeMembers        Boolean  @default(true)
  includeLeaders        Boolean  @default(true)

  // Contract expiry (Ethiopian date as entered) + normalised Gregorian equivalent
  expiryEthYear         Int
  expiryEthMonth        Int
  expiryEthDay          Int
  expiryDate            DateTime @db.Date

  // Backend-calculated: one Ethiopian month before expiry
  deadlineEthYear       Int
  deadlineEthMonth      Int
  deadlineEthDay        Int
  deadlineDate          DateTime @db.Date

  // Reminders
  monthlyReminderEnabled Boolean @default(true)
  monthlyReminderEthDay  Int     @default(1)    // day-of-Ethiopian-month the monthly reminder goes out
  preDeadlineReminderDays Int    @default(7)    // 0 disables

  receiptUploadsEnabled Boolean  @default(false)
  referenceEnabled      Boolean  @default(true)

  active                Boolean  @default(true)

  createdByUserId       String?
  createdBy             User?    @relation("FundingConfigCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId       String?
  updatedBy             User?    @relation("FundingConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  records               AnnualContributionRecord[]

  @@map("annual_funding_configurations")
}

// One obligation per participant per contribution year.
model AnnualContributionRecord {
  id               String        @id @default(cuid())

  configId         String
  config           AnnualFundingConfiguration @relation(fields: [configId], references: [id], onDelete: Restrict)

  participantId    String
  participant      User          @relation("AnnualParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  contributionYear Int
  amountDueMinor   Int           // snapshot at creation; later config changes do not rewrite history
  status           FundingStatus @default(UNPAID)
  paidMinor        Int           @default(0) 

  // Denormalised "current decision" for fast lists. Source of truth = declarations.
  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?

  // Optimistic-concurrency guard for atomic transitions.
  version          Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  declarations     FundingDeclaration[]

  // SRS 3.2: at most one active obligation per participant per year.
  @@unique([participantId, contributionYear])
  @@index([contributionYear, status])
  @@index([configId])
  @@map("annual_contribution_records")
}

model SpecialDonationCampaign {
  id                   String         @id @default(cuid())

  title                String
  description          String
  donationType         DonationType

  requestedAmountMinor Int?           // fixed per-person amount; null = open amount
  targetAmountMinor    Int?

  startEthYear         Int?
  startEthMonth        Int?
  startEthDay          Int?
  startDate            DateTime?      @db.Date

  deadlineEthYear      Int
  deadlineEthMonth     Int
  deadlineEthDay       Int
  deadlineDate         DateTime       @db.Date

  imageUrl             String?
  imagePublicId        String?

  status               CampaignStatus @default(DRAFT)

  createdByUserId      String?
  createdBy            User?          @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  publishedAt          DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?

  payments             SpecialDonationPayment[]

  @@index([status, deadlineDate])
  @@map("special_donation_campaigns")
}

// One payment record per participant per campaign; history lives in declarations.
model SpecialDonationPayment {
  id               String        @id @default(cuid())

  campaignId       String
  campaign         SpecialDonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  participantId    String
  participant      User          @relation("DonationParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  amountMinor      Int           // latest declared amount (what counts once PAID)
  status           FundingStatus @default(UNPAID)
  paidMinor        Int           @default(0) 

  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?
  version          Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  declarations     FundingDeclaration[]

  @@unique([campaignId, participantId])
  @@index([campaignId, status])
  @@map("special_donation_payments")
}

// Append-only declaration history for BOTH annual records and donation payments.
// Exactly one of annualRecordId / donationPaymentId is set (enforced in the service layer + CHECK in migration).
model FundingDeclaration {
  id                String            @id @default(cuid())

  annualRecordId    String?
  annualRecord      AnnualContributionRecord? @relation(fields: [annualRecordId], references: [id], onDelete: Cascade)
  donationPaymentId String?
  donationPayment   SpecialDonationPayment?   @relation(fields: [donationPaymentId], references: [id], onDelete: Cascade)

  participantId     String
  participant       User              @relation("DeclarationParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  amountMinor       Int
  paymentMethod     PaymentMethod?    // <--- ADD THIS LINE
  
  reference         String?
  receiptUrl        String?           // must be served via an authenticated endpoint, never a public link
  receiptPublicId   String?

  // Client-generated id so repeated "I've Paid" taps / retries never create duplicates.
  clientId          String?

  status            DeclarationStatus @default(PENDING)
  declaredAt        DateTime          @default(now())

  decidedByUserId   String?
  decidedBy         User?             @relation("DeclarationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  rejectionReason   String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([participantId, clientId])
  @@index([annualRecordId, declaredAt])
  @@index([donationPaymentId, declaredAt])
  @@index([status, declaredAt])
  @@map("funding_declarations")
}

// Append-only. No update/delete endpoints may exist for this table.
model FundingAuditLog {
  id                String            @id @default(cuid())

  actorId           String?
  actor             User?             @relation("FundingAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action            String            // e.g. DECLARED, APPROVED, REJECTED, CORRECTED, CAMPAIGN_PUBLISHED, CONFIG_UPDATED
  recordType        FundingRecordType
  recordId          String

  previousStatus    String?
  newStatus         String?
  reason            String?
  details           Json?             // old/new values for config & instruction changes

  createdAt         DateTime          @default(now())

  @@index([recordType, recordId])
  @@index([actorId])
  @@index([createdAt])
  @@map("funding_audit_logs")
}

model PaymentInstructions {
  id                String        @id @default(cuid())

  method            PaymentMethod
  providerName      String        // e.g. "Commercial Bank of Ethiopia", "Telebirr"
  accountHolderName String
  accountIdentifier String        // account number / Telebirr number. NEVER credentials/PINs/OTPs.
  note              String?
  active            Boolean       @default(true)

  updatedByUserId   String?
  updatedBy         User?         @relation("PaymentInstructionsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([active])
  @@map("payment_instructions")
}

// De-duplicates scheduled reminders: the job can run twice and still send once.
model FundingReminderLog {
  id         String   @id @default(cuid())
  recipientId String
  recordType FundingRecordType
  recordId   String
  kind       String   // MONTHLY | PRE_DEADLINE | CAMPAIGN_DEADLINE | REJECTED
  periodKey  String   // e.g. "2019-02" for the Ethiopian month, or "2019-pre"
  sentAt     DateTime @default(now())

  @@unique([recipientId, recordType, recordId, kind, periodKey])
  @@map("funding_reminder_logs")
}
