{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rehobot Choir needs access to your photos so you can upload a profile picture.",
          "cameraPermission": "Rehobot Choir needs camera access so you can take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#55883B",
          "androidMode": "default",
          "androidCollapsedTitle": "Rehobot Choir"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d34d781c-a69a-4914-953b-c93507a53c35"
      }
    },
    "owner": "eyobseta"
  }
}
