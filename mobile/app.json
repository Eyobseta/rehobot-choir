{
  "expo": {
    "name": "Rehobot Choir",
    "slug": "rehobot-choir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.eyobseta.rehobotchoir"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rehobot Choir needs access to your photos so you can upload a profile picture and send photos in chat.",
          "cameraPermission": "Rehobot Choir needs camera access so you can take a profile picture or a photo to send in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#55883B",
          "androidMode": "default",
          "androidCollapsedTitle": "Rehobot Choir"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rehobot Choir uses the microphone so you can record voice messages in chat."
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-font",
      "expo-asset",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "d34d781c-a69a-4914-953b-c93507a53c35"
      }
    },
    "owner": "eyobseta",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d34d781c-a69a-4914-953b-c93507a53c35"
    }
  }
}